# Base de Datos Interna (SQLite local por defecto)
FRAMEWORK_DB_URL=sqlite:///./framework_interno.db

# Configuración de Servidor API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1

# Autenticación de Acceso
APP_ACCESS_ENABLED=false
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

# Límites de Seguridad de Ejecución
MAX_RESULT_ROWS=1000
ORACLE_CALL_TIMEOUT_MS=10000

# Ejemplos de Conexión a Base de Datos Objetivo Oracle (NO COLOCAR CREDENCIALES REALES)
# El MVP utiliza perfiles de conexión persistentes, pero las credenciales (contraseñas) 
# deben ser pasadas durante la ejecución de las pruebas.
# En el futuro se pueden usar variables como ORACLE_TARGET_DSN si es necesario.
