ENVIRONMENT=production

FRAMEWORK_DB_URL=sqlite:////data/framework_interno.db
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://dominio.pendiente.com

# Configuración del servidor/dominio (Requisito pendiente del proveedor)
APP_DOMAIN=dominio.pendiente.com

# Restricciones y timeouts
MAX_RESULT_ROWS=1000
ORACLE_CALL_TIMEOUT_MS=10000

# Protección de acceso a la aplicación
APP_ACCESS_ENABLED=true
APP_ACCESS_USERNAME=usuario_ficticio
APP_ACCESS_PASSWORD=contrasena_ficticia
APP_SESSION_SECRET=secreto_ficticio_largo_y_complejo

# Configuración de Oracle (producción académica)
ORACLE_PWD=contrasena_ficticia_admin
FRAMEWORK_TEST_PASSWORD=contrasena_ficticia_test
RUN_ORACLE_TESTS=0
ORACLE_HOST=oracle_db
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_TEST_USER=FRAMEWORK_TEST
