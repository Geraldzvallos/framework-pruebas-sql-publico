graph TD
    subgraph Localhost / Docker Engine
        subgraph Contenedores Principales
            App[FastAPI QA Framework]
            UI[Archivos Estáticos UI]
            DB_Local[(Volumen: framework_data)]
        end
        subgraph Base de Datos Target
            Oracle[(Contenedor: oracle_db)]
        end
    end

    Client[Navegador Web] -- HTTP :8000 --> App
    App -- Lee --> UI
    App -- Lee/Escribe --> DB_Local
    App -- oracledb TCP :1521 --> Oracle
