classDiagram
    class Project {
        +Integer id
        +String name
        +String description
    }
    class ConnectionProfile {
        +Integer id
        +Integer project_id
        +String name
        +String host
        +Integer port
        +String service_name
        +String username
    }
    class TestCase {
        +Integer id
        +Integer project_id
        +String name
        +String description
        +String sql_query
        +String validation_type
        +String expected_result
    }
    class TestSuite {
        +Integer id
        +Integer project_id
        +String name
        +String description
    }
    class ExecutionHistory {
        +Integer id
        +Integer project_id
        +Integer test_case_id
        +Integer suite_id
        +Integer connection_profile_id
        +String status
        +DateTime executed_at
        +Float duration_ms
        +String statement_type
        +String executed_sql
        +String validation_type
        +String expected_result
        +String actual_result
        +Integer rowcount
        +Boolean rollback_applied
        +String rollback_error
        +String error_message
    }

    Project "1" -- "*" ConnectionProfile : contains
    Project "1" -- "*" TestCase : contains
    Project "1" -- "*" TestSuite : contains
    Project "1" -- "*" ExecutionHistory : logs
    TestSuite "*" -- "*" TestCase : includes
