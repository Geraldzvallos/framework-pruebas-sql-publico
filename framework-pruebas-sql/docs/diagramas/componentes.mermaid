graph TD
    subgraph Frontend Client
        UI[Navegador (HTML/CSS/JS)]
    end

    subgraph Backend Server (Uvicorn)
        FastAPI[FastAPI Application]
        Auth[Basic Auth Middleware]
        Routers[API Routers]
        ExecService[Execution Service]
        Security[SQL Security Engine / sqlparse]
        Alembic[Alembic Migrations]
    end

    subgraph Data Stores
        SQLite[(Volumen: framework_data)]
        Oracle[(Contenedor: oracle_db)]
    end

    UI -- HTTP REST --> Auth
    Auth --> FastAPI
    FastAPI --> Routers
    Routers --> ExecService
    ExecService --> Security
    Routers -- CRUD --> SQLite
    Security -- Validation --> Oracle
    ExecService -- oracledb --> Oracle
    Alembic -- schema updates --> SQLite
